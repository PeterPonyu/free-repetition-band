{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PeterPonyu/free-repetition-band/paper/FIGURE-INDEX.schema.json",
  "title": "Paper warehouse FIGURE-INDEX",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "paper_id",
    "github",
    "zenodo_concept_doi",
    "pipeline",
    "figures"
  ],
  "properties": {
    "paper_id": { "const": "E1" },
    "github": { "const": "PeterPonyu/free-repetition-band" },
    "zenodo_concept_doi": { "const": "10.5281/zenodo.21020378" },
    "pipeline": { "type": "string", "minLength": 1 },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "generator",
          "summary",
          "preview_svg",
          "tex_build",
          "vec_build",
          "venue_flat_name"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^E1_[A-Za-z0-9_]+$" },
          "label": { "type": "string", "pattern": "^fig:" },
          "generator": { "type": "string", "minLength": 1 },
          "summary": { "type": ["string", "null"] },
          "preview_svg": { "type": ["string", "null"] },
          "tex_build": { "type": "string", "minLength": 1 },
          "vec_build": { "type": "string", "minLength": 1 },
          "venue_flat_name": {
            "type": ["string", "null"],
            "pattern": "^Figure[0-9]+\\.pdf$"
          }
        }
      }
    }
  }
}
